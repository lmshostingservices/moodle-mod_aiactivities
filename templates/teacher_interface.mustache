{{!
    @template mod_aiactivities/teacher_interface

    Generation and management interface shown to users who can create activities.

    Context variables required for this template:
    * hasactivities - bool, whether activities have already been generated
    * voiceoverenabled - bool, whether narration is enabled on this instance
    * languages - array of groups, each with label and options (value, label, selected)
    * activitycounts - array of options (value, label, selected)
    * voices - array of options (value, label, selected)
    * voicegenders - array of options (value, label, selected)
    * workerlevels - array of levels (value, label)
    * activitytypes - array of types (value, label, description, icon, checked)
    * paused - bool, whether an administrator has paused AI generation
    * review - object: awaiting (bool), released (bool), message (string), required (bool)

    Example context (json):
    {
        "hasactivities": false,
        "ownai": {"any": true, "text": true, "voice": false, "freevoice": true, "label": "Activities"},
        "voiceoverenabled": false,
        "languages": [{"label": "English", "options": [{"value": "en-AU", "label": "English (Australian)", "selected": true}]}],
        "activitycounts": [{"value": 8, "label": "8 activities", "selected": true}],
        "voices": [{"value": "Zephyr", "label": "Zephyr (female)", "selected": true}],
        "voicegenders": [{"value": "female", "label": "Female", "selected": true}],
        "workerlevels": [{"value": "Worker", "label": "Worker"}],
        "activitytypes": [{"value": "cardselect", "label": "Card select", "description": "Pick the right card", "icon": "fa-clone", "checked": true}],
        "paused": false,
        "review": {"awaiting": true, "released": false, "message": "", "required": true}
    }
}}
<div id="ala-app" class="ala-container mds-premium ala-teacher" data-ai-generated="true">
    <div class="ala-teacher-top">
        <span class="lx-eyebrow ala-eyebrow">{{#str}}teacher_eyebrow, mod_aiactivities{{/str}}</span>
        <div class="ala-teacher-badges">
            {{#ownai.any}}
            <span class="mds-badge badge mds-badge--success mds-badge--subtle ala-byok-badge" title="{{#str}}byok_badge_title, mod_aiactivities{{/str}}">
                <i class="fa fa-microchip" aria-hidden="true"></i>
                <span class="ala-byok-badge-label">{{#str}}byok_badge, mod_aiactivities{{/str}}</span>
                <span class="ala-byok-badge-detail">{{ownai.label}}</span>
            </span>
            {{/ownai.any}}
            {{^ownai.text}}
            <span class="mds-badge badge mds-badge--primary mds-badge--subtle ala-credits-badge">
                <i class="fa fa-coins" aria-hidden="true"></i>
                <span id="ala-credits-value">--</span>
                <span class="ala-credits-label">{{#str}}credits_label, mod_aiactivities{{/str}}</span>
            </span>
            {{/ownai.text}}
        </div>
    </div>

    {{#paused}}
    <div class="mds-alert alert mds-alert--warning alert-warning ala-paused-alert" role="status">
        <span class="mds-alert-icon-wrap" aria-hidden="true"><span class="mds-alert-icon"></span></span>
        <div class="mds-alert-content">
            <div class="mds-alert-text">
                <p class="mds-alert-title">{{#str}}paused_title, mod_aiactivities{{/str}}</p>
                <p class="mds-alert-message">{{#str}}paused_message, mod_aiactivities{{/str}}</p>
            </div>
        </div>
    </div>
    {{/paused}}

    <div id="ala-form-section" class="ala-card lx-card" {{#hasactivities}}style="display:none;"{{/hasactivities}}>
        <div class="ala-card-head">
            <span class="ala-card-icon" aria-hidden="true"><i class="fa fa-wand-magic-sparkles"></i></span>
            <div class="ala-card-headtext">
                <h3 class="ala-card-title">{{#str}}page_heading, mod_aiactivities{{/str}}</h3>
                <p class="ala-intro">{{#str}}page_intro, mod_aiactivities{{/str}}</p>
            </div>
        </div>

        <details class="ala-literacy">
            <summary class="ala-literacy-summary">
                <i class="fa fa-scale-balanced" aria-hidden="true"></i>
                <span>{{#str}}literacy_title, mod_aiactivities{{/str}}</span>
            </summary>
            <div class="ala-literacy-body">
                <ul class="ala-literacy-list">
                    <li><strong>{{#str}}literacy_responsible_title, mod_aiactivities{{/str}}</strong> {{#str}}literacy_responsible, mod_aiactivities{{/str}}</li>
                    <li><strong>{{#str}}literacy_limits_title, mod_aiactivities{{/str}}</strong> {{#str}}literacy_limits, mod_aiactivities{{/str}}</li>
                    <li><strong>{{#str}}literacy_bias_title, mod_aiactivities{{/str}}</strong> {{#str}}literacy_bias, mod_aiactivities{{/str}}</li>
                    <li><strong>{{#str}}literacy_data_title, mod_aiactivities{{/str}}</strong> {{#str}}literacy_data, mod_aiactivities{{/str}}</li>
                    <li><strong>{{#str}}literacy_report_title, mod_aiactivities{{/str}}</strong> {{#str}}literacy_report, mod_aiactivities{{/str}}</li>
                </ul>
            </div>
        </details>

        <form id="ala-form">
            <div class="ala-form-group">
                <label for="ala-content" class="ala-label">{{#str}}content_label, mod_aiactivities{{/str}}</label>
                <textarea id="ala-content" class="ala-textarea form-control" rows="10" placeholder="{{#str}}content_placeholder, mod_aiactivities{{/str}}" aria-describedby="ala-content-help"></textarea>
                <small class="ala-help" id="ala-content-help">{{#str}}content_help, mod_aiactivities{{/str}}</small>
            </div>

            <div class="ala-form-row">
                <div class="ala-form-group ala-half">
                    <label for="ala-language" class="ala-label">{{#str}}language_label, mod_aiactivities{{/str}}</label>
                    <select id="ala-language" class="ala-select form-select custom-select">
                        {{#languages}}
                            <optgroup label="{{label}}">
                                {{#options}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/options}}
                            </optgroup>
                        {{/languages}}
                    </select>
                </div>
                <div class="ala-form-group ala-half">
                    <label for="ala-activitycount" class="ala-label">{{#str}}activitycount_label, mod_aiactivities{{/str}}</label>
                    <select id="ala-activitycount" class="ala-select form-select custom-select">
                        {{#activitycounts}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/activitycounts}}
                    </select>
                </div>
            </div>

            <fieldset class="ala-form-group ala-types-fieldset">
                <legend class="ala-label">{{#str}}activitytypes_label, mod_aiactivities{{/str}}</legend>
                <button type="button" id="ala-types-all" class="mds-btn btn btn-ghost mds-btn--size-sm ala-link-btn">{{#str}}activitytypes_selectall, mod_aiactivities{{/str}}</button>
                <small class="ala-help">{{#str}}activitytypes_help, mod_aiactivities{{/str}}</small>
                <div class="ala-types-grid" id="ala-activity-types">
                    {{#activitytypes}}
                        <label class="ala-type-option ala-type-{{value}}">
                            <input type="checkbox" class="ala-type-checkbox" value="{{value}}" {{#checked}}checked{{/checked}}>
                            <span class="ala-type-card">
                                <span class="ala-type-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>
                                <span class="ala-type-text">
                                    <span class="ala-type-name">{{label}}</span>
                                    <span class="ala-type-desc">{{description}}</span>
                                </span>
                                <span class="ala-type-tick" aria-hidden="true"><i class="fa fa-check"></i></span>
                            </span>
                        </label>
                    {{/activitytypes}}
                </div>
            </fieldset>

            <div class="ala-option-section ala-scenario-section">
                <div class="ala-form-group">
                    <label class="ala-toggle-label">
                        <input type="checkbox" id="ala-scenario-toggle" class="ala-toggle-checkbox" role="switch">
                        <span class="ala-toggle-switch" aria-hidden="true"></span>
                        <span class="ala-toggle-text">{{#str}}scenario_toggle, mod_aiactivities{{/str}}</span>
                    </label>
                    <small class="ala-help">{{#str}}scenario_help, mod_aiactivities{{/str}}</small>
                </div>
                <div id="ala-scenario-fields" class="ala-scenario-fields" style="display:none;" hidden>
                    <div class="ala-form-row ala-form-row-3">
                        <div class="ala-form-group ala-third">
                            <label for="ala-scenario-country" class="ala-label">{{#str}}scenario_country, mod_aiactivities{{/str}}</label>
                            <input type="text" id="ala-scenario-country" class="ala-input form-control" placeholder="{{#str}}scenario_country_placeholder, mod_aiactivities{{/str}}">
                        </div>
                        <div class="ala-form-group ala-third">
                            <label for="ala-scenario-industry" class="ala-label">{{#str}}scenario_industry, mod_aiactivities{{/str}}</label>
                            <select id="ala-scenario-industry" class="ala-input ala-select form-select custom-select">
                                <option value="">{{#str}}scenario_industry_placeholder_select, mod_aiactivities{{/str}}</option>
                            </select>
                        </div>
                        <div class="ala-form-group ala-third">
                            <span class="ala-label" id="ala-job-level-label">{{#str}}scenario_worker_level, mod_aiactivities{{/str}} <small>{{#str}}scenario_worker_level_hint, mod_aiactivities{{/str}}</small></span>
                            <div class="ala-level-pills" id="ala-job-level-pills" role="group" aria-labelledby="ala-job-level-label">
                                {{#workerlevels}}
                                    <button type="button" class="mds-btn btn btn-secondary mds-btn--size-sm ala-level-pill" data-value="{{value}}" aria-pressed="false">{{label}}</button>
                                {{/workerlevels}}
                            </div>
                        </div>
                    </div>
                    <div class="ala-form-row">
                        <div class="ala-form-group">
                            <label for="ala-scenario-sector" class="ala-label">{{#str}}scenario_sector, mod_aiactivities{{/str}} <small>{{#str}}optional_hint, mod_aiactivities{{/str}}</small></label>
                            <select id="ala-scenario-sector" class="ala-input ala-select form-select custom-select" disabled>
                                <option value="">{{#str}}scenario_sector_placeholder, mod_aiactivities{{/str}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="ala-form-row">
                        <div class="ala-form-group">
                            <label for="ala-job-role-input" class="ala-label">{{#str}}scenario_jobroles, mod_aiactivities{{/str}} <small>{{#str}}scenario_jobroles_hint, mod_aiactivities{{/str}}</small></label>
                            <div class="ala-role-chips" id="ala-job-role-chips"></div>
                            <input type="text" id="ala-job-role-input" class="ala-input form-control" placeholder="{{#str}}scenario_jobroles_placeholder, mod_aiactivities{{/str}}">
                        </div>
                    </div>
                </div>
            </div>

            <div class="ala-option-section ala-voiceover-section">
                <div class="ala-form-group">
                    <label class="ala-toggle-label">
                        <input type="checkbox" id="ala-voiceover-toggle" class="ala-toggle-checkbox" role="switch">
                        <span class="ala-toggle-switch" aria-hidden="true"></span>
                        <span class="ala-toggle-text">{{#str}}voiceover_toggle, mod_aiactivities{{/str}} <small>{{#ownai.freevoice}}{{#str}}byok_voice_note, mod_aiactivities{{/str}}{{/ownai.freevoice}}{{^ownai.freevoice}}{{#str}}voiceover_credit_note, mod_aiactivities{{/str}}{{/ownai.freevoice}}</small></span>
                    </label>
                    <small class="ala-help">{{#str}}voiceover_help, mod_aiactivities{{/str}}</small>
                </div>
                <div id="ala-voiceover-fields" class="ala-voiceover-fields" style="display:none;" hidden>
                    <div class="ala-form-row ala-form-row-2">
                        <div class="ala-form-group ala-half">
                            <label for="ala-voice-gender" class="ala-label">{{#str}}voice_gender, mod_aiactivities{{/str}}</label>
                            <select id="ala-voice-gender" class="ala-input ala-select form-select custom-select">
                                {{#voicegenders}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/voicegenders}}
                            </select>
                        </div>
                        <div class="ala-form-group ala-half">
                            <label for="ala-voice-id" class="ala-label">{{#str}}voice_label, mod_aiactivities{{/str}}</label>
                            <select id="ala-voice-id" class="ala-input ala-select form-select custom-select">
                                {{#voices}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/voices}}
                            </select>
                        </div>
                    </div>
                    <p class="ala-help ala-voice-ai-note"><i class="fa fa-circle-info" aria-hidden="true"></i> {{#str}}voice_ai_note, mod_aiactivities{{/str}}</p>
                </div>
            </div>

            <div class="ala-cost-summary">
                <div class="ala-cost-row" id="ala-cost-per-activity-row">
                    <span class="ala-cost-label">{{#str}}cost_per_activity, mod_aiactivities{{/str}}</span>
                    <span class="ala-cost-value" id="ala-cost-per-activity"></span>
                </div>
                <div class="ala-cost-row ala-cost-total">
                    <span class="ala-cost-label">{{#str}}cost_total, mod_aiactivities{{/str}}</span>
                    <span class="ala-cost-value" id="ala-total-cost"></span>
                </div>
            </div>

            {{#review.required}}
            <p class="ala-help ala-review-hint"><i class="fa fa-user-check" aria-hidden="true"></i> {{#str}}review_hint, mod_aiactivities{{/str}}</p>
            {{/review.required}}

            <div class="ala-form-actions">
                <button type="button" id="ala-generate-btn" class="mds-btn btn btn-primary mds-btn--size-lg ala-btn ala-btn-primary" {{#paused}}disabled{{/paused}}>
                    <i class="fa fa-wand-magic-sparkles" aria-hidden="true"></i>
                    {{#str}}generate_btn, mod_aiactivities{{/str}}
                </button>
            </div>

            <div id="ala-progress-bar" class="ala-progress-container mds-progress-bar" style="display:none;">
                <div class="ala-progress-bar progress mds-progress-bar-track" role="progressbar" aria-labelledby="ala-progress-text" aria-valuemin="0" aria-valuemax="100">
                    <div class="ala-progress-fill progress-bar mds-progress-bar-fill" id="ala-progress-fill"></div>
                </div>
                <p class="ala-progress-text" id="ala-progress-text" role="status" aria-live="polite">{{#str}}generating, mod_aiactivities{{/str}}</p>
            </div>
        </form>
    </div>

    {{#hasactivities}}
        <div id="ala-review-panel" class="ala-review-panel" data-released="{{#review.released}}1{{/review.released}}{{^review.released}}0{{/review.released}}">
            {{#review.awaiting}}
            <div class="mds-alert alert mds-alert--warning alert-warning ala-review-alert" id="ala-review-awaiting">
                <span class="mds-alert-icon-wrap" aria-hidden="true"><span class="mds-alert-icon"></span></span>
                <div class="mds-alert-content">
                    <div class="mds-alert-text">
                        <p class="mds-alert-title">{{#str}}review_awaiting_title, mod_aiactivities{{/str}}</p>
                        <p class="mds-alert-message">{{#str}}review_awaiting_message, mod_aiactivities{{/str}}</p>
                    </div>
                    <div class="ala-review-actions">
                        <div class="mds-checkbox form-check ala-review-ack">
                            <div class="mds-checkbox-input-wrapper"><input class="mds-checkbox-input form-check-input" type="checkbox" id="ala-review-ack"></div>
                            <label class="mds-checkbox-label form-check-label" for="ala-review-ack"><span class="mds-checkbox-label-text">{{#str}}review_ack, mod_aiactivities{{/str}}</span></label>
                        </div>
                        <button type="button" id="ala-release-btn" class="mds-btn btn btn-primary mds-btn--size-md" disabled>
                            <i class="fa fa-user-check" aria-hidden="true"></i>
                            {{#str}}review_release_btn, mod_aiactivities{{/str}}
                        </button>
                    </div>
                </div>
            </div>
            {{/review.awaiting}}
            <div class="mds-alert alert mds-alert--success alert-success mds-alert--no-title ala-review-done" id="ala-review-released" {{^review.released}}hidden{{/review.released}}>
                <span class="mds-alert-icon-wrap" aria-hidden="true"><span class="mds-alert-icon"></span></span>
                <div class="mds-alert-content">
                    <div class="mds-alert-text" role="status"><p class="mds-alert-message" id="ala-review-released-text">{{review.message}}</p></div>
                </div>
            </div>
        </div>

        <div id="ala-manage-section" class="ala-card lx-card ala-manage-card">
            <div class="mds-alert alert mds-alert--no-title ala-teacher-info-banner">
                <span class="mds-alert-icon-wrap" aria-hidden="true"><span class="mds-alert-icon"></span></span>
                <div class="mds-alert-content">
                    <div class="mds-alert-text"><p class="mds-alert-message">{{#str}}manage_live_banner, mod_aiactivities{{/str}}</p></div>
                </div>
            </div>
            <div class="ala-manage-header">
                <h3 class="ala-card-title">
                    <span class="ala-card-icon ala-card-icon--sm" aria-hidden="true"><i class="fa fa-list-check"></i></span>
                    {{#str}}manage_heading, mod_aiactivities{{/str}}
                </h3>
                <div class="ala-manage-actions">
                    {{#voiceoverenabled}}
                        <button type="button" id="ala-regen-audio-btn" class="mds-btn btn btn-secondary mds-btn--size-md ala-btn ala-btn-outline" {{#paused}}disabled{{/paused}}>
                            <i class="fa fa-microphone" aria-hidden="true"></i>
                            {{#str}}regenerate_audio_btn, mod_aiactivities{{/str}}
                        </button>
                    {{/voiceoverenabled}}
                    <button type="button" id="ala-regenerate-btn" class="mds-btn btn btn-secondary mds-btn--size-md ala-btn ala-btn-outline" {{#paused}}disabled{{/paused}}>
                        <i class="fa fa-arrows-rotate" aria-hidden="true"></i>
                        {{#str}}regenerate_btn, mod_aiactivities{{/str}}
                    </button>
                </div>
            </div>
            <div id="ala-activities-preview" class="ala-activities-preview"></div>
        </div>

        <div id="ala-teacher-preview" class="ala-card lx-card" style="display:none;">
            <div class="ala-manage-header">
                <button type="button" id="ala-preview-back-btn" class="mds-btn btn btn-secondary mds-btn--size-md ala-btn ala-btn-outline">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>
                    {{#str}}back_to_activities, mod_aiactivities{{/str}}
                </button>
                <span id="ala-preview-label" class="ala-preview-label"></span>
            </div>
            <div id="ala-preview-content" class="ala-player-content"></div>
            <div id="ala-preview-feedback" class="ala-player-feedback ala-feedback-hidden" role="status" aria-live="polite"></div>
        </div>

        <div id="ala-teacher-edit" class="ala-card lx-card" style="display:none;">
            <div class="ala-manage-header">
                <button type="button" id="ala-edit-back-btn" class="mds-btn btn btn-secondary mds-btn--size-md ala-btn ala-btn-outline">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>
                    {{#str}}back_to_activities, mod_aiactivities{{/str}}
                </button>
                <span id="ala-edit-label" class="ala-preview-label"></span>
            </div>
            <div id="ala-edit-content"></div>
        </div>
    {{/hasactivities}}
</div>
