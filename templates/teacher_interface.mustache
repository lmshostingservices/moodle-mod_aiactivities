{{!
    @template mod_aiactivities/teacher_interface

    Generation and management interface shown to users who can create activities.

    Context variables required for this template:
    * hasactivities - bool, whether activities have already been generated
    * voiceoverenabled - bool, whether narration is enabled on this instance
    * languages - array of groups, each with label and options (value, label, selected)
    * activitycounts - array of options (value, label, selected)
    * voices - array of options (value, label, selected)
    * voicegenders - array of options (value, label, selected)
    * workerlevels - array of levels (value, label)

    Example context (json):
    {
        "hasactivities": false,
        "voiceoverenabled": false,
        "languages": [{"label": "English", "options": [{"value": "en-AU", "label": "English (Australian)", "selected": true}]}],
        "activitycounts": [{"value": 8, "label": "8 activities", "selected": true}],
        "voices": [{"value": "Zephyr", "label": "Zephyr (female)", "selected": true}],
        "voicegenders": [{"value": "female", "label": "Female", "selected": true}],
        "workerlevels": [{"value": "Worker", "label": "Worker"}]
    }
}}
<div id="ala-app" class="ala-container">
    <div class="ala-credits-badge">
        <svg class="ala-credits-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10"/>
            <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
            <path d="M12 18V6"/>
        </svg>
        <span id="ala-credits-value">--</span>
        <span class="ala-credits-label">{{#str}}credits_label, mod_aiactivities{{/str}}</span>
    </div>

    <div id="ala-form-section" class="ala-card" {{#hasactivities}}style="display:none;"{{/hasactivities}}>
        <h3 class="ala-card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
            {{#str}}page_heading, mod_aiactivities{{/str}}
        </h3>
        <p class="ala-intro">{{#str}}page_intro, mod_aiactivities{{/str}}</p>

        <form id="ala-form">
            <div class="ala-form-group">
                <label for="ala-content" class="ala-label">{{#str}}content_label, mod_aiactivities{{/str}}</label>
                <textarea id="ala-content" class="ala-textarea" rows="10" placeholder="{{#str}}content_placeholder, mod_aiactivities{{/str}}"></textarea>
                <small class="ala-help">{{#str}}content_help, mod_aiactivities{{/str}}</small>
            </div>

            <div class="ala-form-row">
                <div class="ala-form-group ala-half">
                    <label for="ala-language" class="ala-label">{{#str}}language_label, mod_aiactivities{{/str}}</label>
                    <select id="ala-language" class="ala-select">
                        {{#languages}}
                            <optgroup label="{{label}}">
                                {{#options}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/options}}
                            </optgroup>
                        {{/languages}}
                    </select>
                </div>
                <div class="ala-form-group ala-half">
                    <label for="ala-activitycount" class="ala-label">{{#str}}activitycount_label, mod_aiactivities{{/str}}</label>
                    <select id="ala-activitycount" class="ala-select">
                        {{#activitycounts}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/activitycounts}}
                    </select>
                </div>
            </div>

            <div class="ala-scenario-section">
                <div class="ala-form-group">
                    <label class="ala-toggle-label">
                        <input type="checkbox" id="ala-scenario-toggle" class="ala-toggle-checkbox">
                        <span class="ala-toggle-switch"></span>
                        <span class="ala-toggle-text">{{#str}}scenario_toggle, mod_aiactivities{{/str}}</span>
                    </label>
                    <small class="ala-help">{{#str}}scenario_help, mod_aiactivities{{/str}}</small>
                </div>
                <div id="ala-scenario-fields" class="ala-scenario-fields" style="display:none;" hidden>
                    <div class="ala-form-row ala-form-row-3">
                        <div class="ala-form-group ala-third">
                            <label for="ala-scenario-country" class="ala-label">{{#str}}scenario_country, mod_aiactivities{{/str}}</label>
                            <input type="text" id="ala-scenario-country" class="ala-input" placeholder="{{#str}}scenario_country_placeholder, mod_aiactivities{{/str}}">
                        </div>
                        <div class="ala-form-group ala-third">
                            <label for="ala-scenario-industry" class="ala-label">{{#str}}scenario_industry, mod_aiactivities{{/str}}</label>
                            <select id="ala-scenario-industry" class="ala-input">
                                <option value="">{{#str}}scenario_industry_placeholder_select, mod_aiactivities{{/str}}</option>
                            </select>
                        </div>
                        <div class="ala-form-group ala-third">
                            <span class="ala-label" id="ala-job-level-label">{{#str}}scenario_worker_level, mod_aiactivities{{/str}} <small>{{#str}}scenario_worker_level_hint, mod_aiactivities{{/str}}</small></span>
                            <div class="ala-level-pills" id="ala-job-level-pills" role="group" aria-labelledby="ala-job-level-label">
                                {{#workerlevels}}
                                    <button type="button" class="ala-level-pill" data-value="{{value}}" aria-pressed="false">{{label}}</button>
                                {{/workerlevels}}
                            </div>
                        </div>
                    </div>
                    <div class="ala-form-row">
                        <div class="ala-form-group">
                            <label for="ala-scenario-sector" class="ala-label">{{#str}}scenario_sector, mod_aiactivities{{/str}} <small>{{#str}}optional_hint, mod_aiactivities{{/str}}</small></label>
                            <select id="ala-scenario-sector" class="ala-input" disabled>
                                <option value="">{{#str}}scenario_sector_placeholder, mod_aiactivities{{/str}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="ala-form-row">
                        <div class="ala-form-group">
                            <label for="ala-job-role-input" class="ala-label">{{#str}}scenario_jobroles, mod_aiactivities{{/str}} <small>{{#str}}scenario_jobroles_hint, mod_aiactivities{{/str}}</small></label>
                            <div class="ala-role-chips" id="ala-job-role-chips"></div>
                            <input type="text" id="ala-job-role-input" class="ala-input" placeholder="{{#str}}scenario_jobroles_placeholder, mod_aiactivities{{/str}}">
                        </div>
                    </div>
                </div>
            </div>

            <div class="ala-voiceover-section">
                <div class="ala-form-group">
                    <label class="ala-toggle-label">
                        <input type="checkbox" id="ala-voiceover-toggle" class="ala-toggle-checkbox">
                        <span class="ala-toggle-switch"></span>
                        <span class="ala-toggle-text">{{#str}}voiceover_toggle, mod_aiactivities{{/str}} <small>{{#str}}voiceover_credit_note, mod_aiactivities{{/str}}</small></span>
                    </label>
                    <small class="ala-help">{{#str}}voiceover_help, mod_aiactivities{{/str}}</small>
                </div>
                <div id="ala-voiceover-fields" class="ala-voiceover-fields" style="display:none;" hidden>
                    <div class="ala-form-row ala-form-row-2">
                        <div class="ala-form-group ala-half">
                            <label for="ala-voice-gender" class="ala-label">{{#str}}voice_gender, mod_aiactivities{{/str}}</label>
                            <select id="ala-voice-gender" class="ala-input">
                                {{#voicegenders}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/voicegenders}}
                            </select>
                        </div>
                        <div class="ala-form-group ala-half">
                            <label for="ala-voice-id" class="ala-label">{{#str}}voice_label, mod_aiactivities{{/str}}</label>
                            <select id="ala-voice-id" class="ala-input">
                                {{#voices}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/voices}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ala-cost-summary">
                <div class="ala-cost-row" id="ala-cost-per-activity-row">
                    <span class="ala-cost-label">{{#str}}cost_per_activity, mod_aiactivities{{/str}}</span>
                    <span class="ala-cost-value" id="ala-cost-per-activity"></span>
                </div>
                <div class="ala-cost-row ala-cost-total">
                    <span class="ala-cost-label">{{#str}}cost_total, mod_aiactivities{{/str}}</span>
                    <span class="ala-cost-value" id="ala-total-cost"></span>
                </div>
            </div>

            <div class="ala-form-actions">
                <button type="button" id="ala-generate-btn" class="ala-btn ala-btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v14"/><path d="m5 10 7 7 7-7"/></svg>
                    {{#str}}generate_btn, mod_aiactivities{{/str}}
                </button>
            </div>

            <div id="ala-progress-bar" class="ala-progress-container" style="display:none;">
                <div class="ala-progress-bar">
                    <div class="ala-progress-fill" id="ala-progress-fill"></div>
                </div>
                <p class="ala-progress-text" id="ala-progress-text" role="status" aria-live="polite">{{#str}}generating, mod_aiactivities{{/str}}</p>
            </div>
        </form>
    </div>

    {{#hasactivities}}
        <div id="ala-manage-section" class="ala-card ala-manage-card">
            <div class="ala-teacher-info-banner">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span>{{#str}}manage_live_banner, mod_aiactivities{{/str}}</span>
            </div>
            <div class="ala-manage-header">
                <h3 class="ala-card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    {{#str}}manage_heading, mod_aiactivities{{/str}}
                </h3>
                <div class="ala-manage-actions">
                    {{#voiceoverenabled}}
                        <button type="button" id="ala-regen-audio-btn" class="ala-btn ala-btn-outline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                            {{#str}}regenerate_audio_btn, mod_aiactivities{{/str}}
                        </button>
                    {{/voiceoverenabled}}
                    <button type="button" id="ala-regenerate-btn" class="ala-btn ala-btn-outline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                        {{#str}}regenerate_btn, mod_aiactivities{{/str}}
                    </button>
                </div>
            </div>
            <div id="ala-activities-preview" class="ala-activities-preview"></div>
        </div>

        <div id="ala-teacher-preview" class="ala-card" style="display:none;">
            <div class="ala-manage-header">
                <button type="button" id="ala-preview-back-btn" class="ala-btn ala-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    {{#str}}back_to_activities, mod_aiactivities{{/str}}
                </button>
                <span id="ala-preview-label" class="ala-preview-label"></span>
            </div>
            <div id="ala-preview-content" class="ala-player-content"></div>
            <div id="ala-preview-feedback" class="ala-player-feedback ala-feedback-hidden" role="status" aria-live="polite"></div>
        </div>

        <div id="ala-teacher-edit" class="ala-card" style="display:none;">
            <div class="ala-manage-header">
                <button type="button" id="ala-edit-back-btn" class="ala-btn ala-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    {{#str}}back_to_activities, mod_aiactivities{{/str}}
                </button>
                <span id="ala-edit-label" class="ala-preview-label"></span>
            </div>
            <div id="ala-edit-content"></div>
        </div>
    {{/hasactivities}}
</div>
